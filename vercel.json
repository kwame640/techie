{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/[...catchall].js": {
      "runtime": "@vercel/node@4",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...catchall]" },
    { "source": "/uploads/:path*", "destination": "/api/[...catchall]" },
    { "source": "/((?!api/|uploads/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
