# NKAY server configuration (copy to .env and fill in real values)
PORT=3001

# Admin / vendor sessions
ADMIN_EMAIL=
ADMIN_PASSWORD=
VENDOR_SESSION_SECRET=

# Hubtel Direct Receive Money — required for checkout to accept payments.
# Get these from Hubtel dashboard -> API & Integrations -> API Credentials.
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
# Merchant account number (POS Sales ID) that receives the money.
HUBTEL_MERCHANT_ACCOUNT_NUMBER=

# Public HTTPS URL of this server. Hubtel sends payment callbacks to
# ${PUBLIC_SERVER_URL}/api/payments/hubtel/callback — localhost will not work.
PUBLIC_SERVER_URL=

# Optional shared secret appended to the callback URL as ?token=...
# Strongly recommended so unknown callers cannot trigger payment re-checks.
HUBTEL_CALLBACK_TOKEN=

# Optional: override the callback URL entirely instead of deriving it.
# HUBTEL_CALLBACK_URL=https://api.example.com/api/payments/hubtel/callback

# Optional API overrides. Only change these for testing with a local stub.
HUBTEL_RECEIVE_BASE_URL=https://rmp.hubtel.com
HUBTEL_STATUS_BASE_URL=https://api-txnstatus.hubtel.com
HUBTEL_TIMEOUT_MS=15000

# Optional push notification keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
