# NKAY server configuration (copy to .env and fill in real values)
PORT=3001

# Admin / vendor sessions
ADMIN_EMAIL=
ADMIN_PASSWORD=
VENDOR_SESSION_SECRET=

# MTN Mobile Money (MoMo) Collections API — required for checkout to accept payments.
#
# Sandbox: subscribe to "Collections" at https://momodeveloper.mtn.com, then
# create an API user + API key yourself (see SERVER_SETUP.md). Sandbox requests
# are WAF-blocked from many cloud hosts, including Vercel, so use production for
# a deployed checkout.
#
# Live: get the User ID, Credential Token and Collections subscription key from
# the MTN Ghana Partner Portal after go-live approval.
MOMO_SUBSCRIPTION_KEY=
MOMO_USER_ID=
# On the live platform this is the "Credential Token". MOMO_CREDENTIAL_TOKEN is
# accepted as an alias.
MOMO_API_KEY=
# MOMO_CREDENTIAL_TOKEN=

# "sandbox" uses https://sandbox.momodeveloper.mtn.com, "live" uses the MTN
# production host (https://momoapi.momo.africa).
MOMO_ENV=sandbox

# Required for live: `mtnghana`. Must be `sandbox` in sandbox mode.
MOMO_TARGET_ENVIRONMENT=
# Required for live: `GHS`. Sandbox settles in EUR.
MOMO_CURRENCY=
# Optional. Set this if MTN gives your account a different API host.
MOMO_BASE_URL=
MOMO_TIMEOUT_MS=20000

# Optional. Enables GET /api/payments/momo/diagnose?key=... which prints masked
# credentials and MTN's token response. Leave empty to disable the route.
MOMO_DIAGNOSE_KEY=

# Public URL of the storefront. The order page is ${PUBLIC_APP_URL}/order/:orderId.
PUBLIC_APP_URL=

# Public HTTPS URL of the API server. MTN posts callbacks to
# ${PUBLIC_SERVER_URL}/api/payments/momo/callback — localhost will not work.
# Falls back to PUBLIC_APP_URL when omitted. Set MOMO_CALLBACK_URL to override
# the full callback URL.
PUBLIC_SERVER_URL=
MOMO_CALLBACK_URL=

# Optional: how long a MoMo PIN prompt stays valid, in minutes (default 10).
MOMO_PROMPT_MINUTES=10

# Optional push notification keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Durable order/stock storage (required on Vercel).
# Reuses the Firebase service account used for OTPs and registrations.
# Without these, serverless deployments refuse new orders instead of writing
# them to /tmp, where they would be lost.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
