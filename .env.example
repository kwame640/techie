# NKAY server configuration (copy to .env and fill in real values)
PORT=3001

# Admin / vendor sessions
ADMIN_EMAIL=
ADMIN_PASSWORD=
VENDOR_SESSION_SECRET=

# Flutterwave Standard checkout — required for checkout to accept payments.
# Get these from the Flutterwave dashboard -> Settings -> API Keys.
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
# The "secret hash" you set under Settings -> Webhooks. Flutterwave sends it
# back in the verif-hash header so the server can reject forged webhooks.
FLW_WEBHOOK_SECRET_HASH=

# Public URL of the storefront. Flutterwave returns the customer to
# ${PUBLIC_APP_URL}/order/:orderId after payment.
PUBLIC_APP_URL=

# Public HTTPS URL of the API server. Flutterwave posts webhooks to
# ${PUBLIC_SERVER_URL}/api/payments/flutterwave/webhook — localhost will not work.
# Falls back to PUBLIC_APP_URL when omitted.
PUBLIC_SERVER_URL=

# Optional: how long a hosted checkout link stays valid, in minutes (default 60).
FLW_SESSION_MINUTES=60

# Optional API overrides. Only change these for testing with a local stub.
FLW_BASE_URL=https://api.flutterwave.com/v3
FLW_TIMEOUT_MS=15000

# Optional push notification keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
