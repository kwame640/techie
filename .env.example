# NKAY server configuration (copy to .env and fill in real values)
PORT=3001

# Admin / vendor sessions
ADMIN_EMAIL=
ADMIN_PASSWORD=
VENDOR_SESSION_SECRET=

# ExpressPay (Ghana) Merchant API — required for checkout to accept payments.
# Get these from your ExpressPay merchant account.
# ExpressPay often allowlists merchant server IPs; if calls fail with status 4
# (Invalid IP), ask ExpressPay to allow this server's egress IPs or use a
# fixed-IP proxy. Vercel serverless egress IPs are dynamic.
EXPAY_MERCHANT_ID=
EXPAY_API_KEY=
# "sandbox" uses https://sandbox.expresspaygh.com, "live" uses https://expresspaygh.com.
EXPAY_ENV=live

# Public URL of the storefront. ExpressPay returns the customer to
# ${PUBLIC_APP_URL}/order/:orderId after payment.
PUBLIC_APP_URL=

# Public HTTPS URL of the API server. ExpressPay posts the callback to
# ${PUBLIC_SERVER_URL}/api/payments/expresspay/callback — localhost will not work.
# Falls back to PUBLIC_APP_URL when omitted.
PUBLIC_SERVER_URL=

# Optional: how long a hosted checkout stays valid, in minutes (default 60).
EXPAY_SESSION_MINUTES=60

# Optional API overrides. Only change these for testing with a local stub.
# Leave EXPAY_BASE_URL empty to use the sandbox/live URL selected by EXPAY_ENV.
EXPAY_BASE_URL=
EXPAY_TIMEOUT_MS=15000

# Optional push notification keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Durable order/stock storage (required on Vercel).
# Reuses the Firebase service account used for OTPs and registrations.
# Without these, serverless deployments refuse new orders instead of writing
# them to /tmp, where they would be lost.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
